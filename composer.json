{
    "name": "fayne/laravel-filament-sso",
    "description": "Single sign-on integrations for Laravel and Filament.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "fayne/laravel-filament-cms-core": "^1.0",
        "filament/filament": "^5.0",
        "laravel/socialite": "^5.0",
        "litesaml/lightsaml": "^4.0",
        "socialiteproviders/microsoft-azure": "^4.0",
        "socialiteproviders/okta": "^4.2"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "laravel/pint": "^1.27"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint --test",
        "format:fix": "pint",
        "lint": "@php tools/lint.php",
        "check": [
            "@lint",
            "@format",
            "@test"
        ]
    },
    "autoload": {
        "psr-4": {
            "Fayne\\Sso\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fayne\\Sso\\SsoServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "authors": [
        {
            "name": "Fayne Guo",
            "email": "fayne.guo@gmail.com"
        }
    ],
    "keywords": [
        "laravel",
        "filament",
        "sso"
    ],
    "$schema": "https://getcomposer.org/schema.json",
    "support": {
        "email": "fayne.guo@gmail.com"
    }
}
